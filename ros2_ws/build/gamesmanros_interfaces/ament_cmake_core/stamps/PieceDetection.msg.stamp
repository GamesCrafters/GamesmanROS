# One AR-tagged game piece seen on the board.
int32  tag_id        # ArUco marker ID — identifies the specific physical piece
int32  cell_index    # index into centers.py for this game, or -1 if off-board
float64 board_x      # position in board cell units (same space as centers.py)
float64 board_y
float64 offset_mm    # distance from the ideal centre of cell_index, in mm
