<?xml version="1.0"?>
<package format="3">
  <name>gamesmanros</name>
  <version>0.1.0</version>
  <description>GamesmanROS — generalized game-playing robotic system (ROS 2)</description>
  <maintainer email="pedorex43@gmail.com">GamesmanROS</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>lifecycle_msgs</depend>
  <depend>action_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>tf_transformations</depend>
  <depend>moveit_msgs</depend>
  <depend>shape_msgs</depend>
  <exec_depend>mycobot_280_moveit_config</exec_depend>
  <depend>gamesmanros_interfaces</depend>
  <depend>mycobot_interfaces</depend>
  <depend>control_msgs</depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
